# Copy is generated automatically by scripts/gen-env.sh (do not commit deploy/.env).
# All values below are placeholders; the generated file holds random secrets.
LITELLM_MASTER_KEY=sk-master-CHANGEME
LITELLM_SALT_KEY=sk-salt-CHANGEME
POSTGRES_PASSWORD=CHANGEME
REDIS_PASSWORD=CHANGEME
# Dummy credentials for the mock providers. Held only in the gateway container env.
MOCK_LOCAL_API_KEY=sk-mock-local-CHANGEME
MOCK_REMOTE_API_KEY=sk-mock-remote-CHANGEME
# The mocks receive only the sha256 of their key (never the key).
MOCK_LOCAL_API_KEY_SHA256=CHANGEME
MOCK_REMOTE_API_KEY_SHA256=CHANGEME
GATEWAY_PORT=4000
